{
  // Standalone IER 919 kiosk peripheral tester backend (Deno).
  // hardware-libs is NOT modified by this app.
  "imports": {
    // The device drivers — the PUBLISHED packages, so a fresh clone builds without sibling repos
    // beside it. None of them is published yet, and they live on three different unmerged
    // hardware-libs branches, so working against them locally means swapping these for relative
    // paths and adding the deps those drivers resolve through this map. README.md lists exactly
    // which, and says why missing one reads as a cascade of implicit-anys. DO NOT COMMIT THAT:
    // facepod-tester had the arrangement committed and a clone without hardware-libs failed with
    // TS2307.
    "@eai/ier/s33380": "jsr:@eai/ier@^1.0.0/s33380",
    "@eai/omron/v4ku": "jsr:@eai/omron@^1.0.0/v4ku",
    "@eai/desko/penta": "jsr:@eai/desko@^1.0.0/penta",
    // `scan`, `readMrz`, `readBarcode` and `image` one at a time, plus the mock symbol table.
    // They are only interpretable against the DLL's process-global "last scan", so the driver
    // keeps them off the device class and behind this subpath; driving them a step at a time is
    // what this tester is for.
    "@eai/desko/penta/bench": "jsr:@eai/desko@^1.0.0/penta/bench",
    "@eai/hid": "jsr:@eai/hid@^1.0.0",
    // The driver's Transport contract — the mock board implements it. Pin matches
    // hardware-libs/deno.jsonc so we resolve the same version.
    "@eai/models": "jsr:@eai/models@^1.3.0",
    // The driver's logger, so its mismatched-ack warning can be put on the page rather than left on
    // this process's stdout. Pin matches hardware-libs/deno.jsonc.
    "@eai/logging-ts": "jsr:@eai/logging-ts@^2.6.0",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/http/file-server": "jsr:@std/http@^1/file-server",
    // Log-handler base class, for the same warning capture.
    "@std/log": "jsr:@std/log@^0.224.0",
    // Test-only.
    "@std/assert": "jsr:@std/assert@^1.0.14"
  },
  "tasks": {
    // Real hardware. --allow-ffi both opens the COM port through @eai/serial's kernel32 FFI and
    // loads PageScanAPI.dll for the passport reader, --allow-net binds the loopback server,
    // --allow-read serves the built UI from ./dist, --allow-env reads PORT and
    // DESKO_PAGESCAN_DLL_PATH.
    "dev": "deno run --allow-ffi --allow-net --allow-env --allow-read server/main.ts",
    // No hardware: fake transports driven through the real drivers. --allow-ffi is still needed,
    // and not to reach a device: `@eai/hotplug` dlopens kernel32 and user32 at module scope, so
    // importing `@eai/omron/v4ku` — which reaches it through `@eai/shared` — asks for FFI before
    // anything is opened. Without it the process dies at import rather than serving a mock.
    "dev:mock": "deno run --allow-ffi --allow-net --allow-env --allow-read server/main.ts --mock",
    // --allow-ffi for the same import-time reason as `dev:mock`, not because a test opens a device.
    "test": "deno test --allow-ffi server/",
    "check": "deno check server/main.ts"
  },
  // Matches hardware-libs so the ported backend stays formatted the way the driver is.
  "fmt": {
    "lineWidth": 140,
    "proseWrap": "preserve",
    "nextControlFlowPosition": "nextLine",
    "exclude": ["src/", "dist/", "node_modules/"]
  },
  "lint": {
    "exclude": ["src/", "dist/", "node_modules/"]
  }
}
