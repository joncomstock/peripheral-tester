{
  // Peripheral tester backend (Deno): IER light board, Omron V4K and Sankyo ICM330 card readers.
  // hardware-libs is NOT modified by this app.
  "imports": {
    // The device drivers, pinned to the versions on hardware-libs master. None is published yet, so
    // "links" below resolves these jsr: specifiers to a hardware-libs master checkout beside this
    // repo (with its own workspace import map, so no transitive deps need listing here). Once they
    // are published, delete "links" and nothing else changes.
    "@eai/ier/s33380": "jsr:@eai/ier@^1.2.3/s33380",
    "@eai/omron-v4k": "jsr:@eai/omron-v4k@^1.2.2",
    "@eai/sankyo": "jsr:@eai/sankyo@^1.0.0",
    "@eai/desko/penta": "jsr:@eai/desko@^1.0.4/penta",
    "@eai/xpm": "jsr:@eai/xpm@^1.1.3",
    "@eai/storm": "jsr:@eai/storm@^1.0.2",
    "@eai/honeywell": "jsr:@eai/honeywell@^1.4.0",
    "@eai/itk38": "jsr:@eai/itk38@^1.1.3",
    "@eai/access-is/adr300": "jsr:@eai/access-is@^3.0.0/adr300",
    "@eai/idtech": "jsr:@eai/idtech@^1.2.0",
    "@eai/datalogic": "jsr:@eai/datalogic@^1.0.0",
    "@eai/custom": "jsr:@eai/custom@^1.2.0",
    "@eai/k8": "jsr:@eai/k8@^1.0.1",
    "@eai/maniacal-labs/allpixel": "jsr:@eai/maniacal-labs@^0.2.2/allpixel",
    "@eai/embross": "jsr:@eai/embross@^1.0.0",
    // The transports, for devices whose driver takes one rather than opening its own.
    "@eai/usb": "jsr:@eai/usb@^1.10.0",
    "@eai/hid": "jsr:@eai/hid@^1.3.0",
    "@eai/serial": "jsr:@eai/serial@^1.3.1",
    // The driver's Transport contract — the mock board implements it. Pin matches
    // hardware-libs/deno.jsonc so we resolve the same version.
    "@eai/models": "jsr:@eai/models@^1.6.0",
    // The driver's logger, so its mismatched-ack warning can be put on the page rather than left on
    // this process's stdout. Pin matches hardware-libs/deno.jsonc.
    "@eai/logging-ts": "jsr:@eai/logging-ts@^2.6.0",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/http/file-server": "jsr:@std/http@^1/file-server",
    // Log-handler base class, for the same warning capture.
    "@std/log": "jsr:@std/log@^0.224.0",
    // Test-only.
    "@std/assert": "jsr:@std/assert@^1.0.14"
  },
  // shortcut: needs hardware-libs master checked out at this path; drop once the drivers are published.
  "links": ["../elevationai/hardware-libs"],
  "tasks": {
    // Real devices. --allow-ffi loads libusb (light board) and hidapi (card readers), --allow-net
    // binds the loopback server, --allow-read serves the built UI from ./dist.
    "dev": "deno run --allow-ffi --allow-net --allow-env --allow-read server/main.ts",
    // No hardware and no FFI permission: a fake Transport driven through the real driver.
    "dev:mock": "deno run --allow-net --allow-env --allow-read server/main.ts --mock",
    "test": "deno test server/",
    "check": "deno check server/main.ts"
  },
  // Matches hardware-libs so the ported backend stays formatted the way the driver is.
  "fmt": {
    "lineWidth": 140,
    "proseWrap": "preserve",
    "nextControlFlowPosition": "nextLine",
    "exclude": ["src/", "dist/", "node_modules/"]
  },
  "lint": {
    "exclude": ["src/", "dist/", "node_modules/"]
  }
}
